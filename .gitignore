/target
Cargo.lock.bak

# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Node
node_modules/

# Debian source-build artifacts
debian/files
debian/*.substvars
debian/*.debhelper.log
debian/.debhelper/
debian/ancilla/
debian/tmp/
debian/debhelper-build-stamp
.cargo-home/

# Generated tarballs (parent dir would have these but local copy here too if accidentally moved)
*.orig.tar.gz
*.debian.tar.xz
*.dsc
*_source.changes
*_source.buildinfo

# Credentials never live here — they live in ~/.local/share/ancilla-publishing/
# These rules belt-and-braces ensure none of them can ever get committed.
.cargo/credentials.toml
.cargo/credentials
.npmrc
.pypirc
**/*.token
**/.env
**/.env.*
!.env.example
